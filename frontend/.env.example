# GmailGuard Frontend — Environment Variables

# ─── Backend API URL ───────────────────────────────────────────────
# Set this to your deployed backend URL for production.
# For local development, leave as http://localhost:8000 (which Vite proxies anyway).

# Local development (default, Vite proxy handles /gmail/* internally):
VITE_API_URL=http://localhost:8000

# Deployed backend (uncomment and use this when you want to point at Render):
# VITE_API_URL=https://email-threat-analyzer-p77w.onrender.com
